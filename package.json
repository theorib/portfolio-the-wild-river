{
  "name": "testing-next-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next-typesafe-url && next build",
    "cz": "bash ./enhanced_commit.sh",
    "dev": "concurrently  \"next-typesafe-url -w\" \"next dev\"",
    "dev:url": "next-typesafe-url -w",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,js,jsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,js,jsx}\"",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint . --quiet && tsc --noEmit --skipLibCheck",
    "lint:debug": "eslint . --debug",
    "lint:debug:prettier": "eslint-config-prettier src/app/layout.tsx",
    "lint:debug:timing": "TIMING=1 eslint",
    "lint:fix": "eslint . --cache --fix",
    "lint:inspect": "pnpm dlx @eslint/config-inspector@latest",
    "lint:next": "next lint",
    "lint:staged": "pnpm lint-staged -v --config lint-staged.config.mjs",
    "lint:tsc": "tsc --noEmit --skipLibCheck",
    "package:sort": "pnpm dlx sort-package-json",
    "prepare": "husky",
    "shad": "pnpm dlx shadcn@canary add",
    "start": "next start",
    "supabase:generate:schemas": "supazod -i src/lib/types/supabase.types.ts -o src/lib/schemas/supabaseSchemas.ts && eslint --fix src/lib/schemas/supabaseSchemas.ts",
    "supabase:generate:types": "dotenv -- supabase gen types typescript --project-id=\"$SUPABASE_PROJECT_ID\" > src/lib/types/supabase.types.ts && eslint --fix src/lib/types/supabase.auto.types.ts",
    "test": "vitest watch --browser.headless",
    "test:coverage": "vitest run --browser.headless --coverage",
    "test:e2e": "exec playwright test",
    "test:e2e:codegen": "exec playwright codegen",
    "test:e2e:debug": "exec playwright test --debug",
    "test:e2e:report": "exec playwright show-report",
    "test:e2e:ui": "exec playwright test --ui",
    "test:ui": "vitest watch --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@loglayer/plugin-redaction": "^2.1.14",
    "@loglayer/plugin-sprintf": "^2.1.14",
    "@loglayer/transport-tslog": "^3.0.12",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.88.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tabler/icons-react": "^3.36.0",
    "@tanstack/react-devtools": "^0.8.4",
    "@tanstack/react-form-devtools": "^0.2.8",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-table": "^8.21.3",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookies-next": "^6.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.6.0",
