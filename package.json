{
	"name": "testing-next-js",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"bd:ui": "bdui start --open --port 3300",
		"build": "next-typesafe-url && next build",
		"cz": "bash ./enhanced_commit.sh",
		"dev": "concurrently  \"next-typesafe-url -w\" \"next dev\"",
		"dev:url": "next-typesafe-url -w",
		"format": "prettier --write \"**/*.{ts,tsx,md,json,js,jsx}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,md,json,js,jsx}\"",
		"preinstall": "npx only-allow pnpm",
		"lint": "eslint . --quiet && tsc --noEmit --skipLibCheck",
		"lint:debug": "eslint . --debug",
		"lint:debug:prettier": "eslint-config-prettier src/app/layout.tsx",
		"lint:debug:timing": "TIMING=1 eslint",
		"lint:fix": "eslint . --cache --fix",
		"lint:inspect": "pnpm dlx @eslint/config-inspector@latest",
		"lint:next": "next lint",
		"lint:staged": "pnpm lint-staged -v --config lint-staged.config.mjs",
		"lint:tsc": "tsc --noEmit --skipLibCheck",
		"package:sort": "pnpm dlx sort-package-json",
		"prepare": "husky",
		"shad": "pnpm dlx shadcn add",
		"start": "next start",
		"supabase:generate:schemas": "supazod -i src/lib/types/supabase.types.ts -o src/lib/schemas/supabaseSchemas.ts && eslint --fix src/lib/schemas/supabaseSchemas.ts",
		"supabase:generate:types": "dotenv -- supabase gen types typescript --project-id=\"$NEXT_PUBLIC_SUPABASE_PROJECT_ID\" > src/lib/types/supabase.types.ts && eslint --fix src/lib/types/supabase.auto.types.ts",
		"test": "vitest watch --browser.headless",
		"test:coverage": "vitest run --browser.headless --coverage",
		"test:e2e": "exec playwright test",
		"test:e2e:codegen": "exec playwright codegen",
		"test:e2e:debug": "exec playwright test --debug",
		"test:e2e:report": "exec playwright show-report",
		"test:e2e:ui": "exec playwright test --ui",
		"test:ui": "vitest watch --ui",
		"typeurl": "npx next-typesafe-url"
	},
	"dependencies": {
		"@base-ui/react": "^1.0.0",
		"@hookform/resolvers": "^5.2.2",
		"@loglayer/plugin-redaction": "^2.1.15",
		"@loglayer/plugin-sprintf": "^2.1.15",
		"@loglayer/transport-tslog": "^3.0.13",
		"@supabase/ssr": "^0.8.0",
		"@supabase/supabase-js": "^2.90.0",
		"@t3-oss/env-nextjs": "^0.13.10",
		"@tabler/icons-react": "^3.36.1",
		"@tanstack/react-devtools": "^0.9.1",
		"@tanstack/react-form": "^1.27.7",
		"@tanstack/react-form-devtools": "^0.2.11",
		"@tanstack/react-form-nextjs": "^1.27.7",
		"@tanstack/react-query": "^5.90.16",
		"@tanstack/react-query-devtools": "^5.91.2",
		"@tanstack/react-table": "^8.21.3",
		"babel-plugin-react-compiler": "19.1.0-rc.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cookies-next": "^6.1.1",
		"date-fns": "^4.1.0",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"loglayer": "^8.4.0",
		"lucide-react": "^0.562.0",
		"next": "16.1.1",
		"next-themes": "^0.4.6",
		"next-typesafe-url": "^6.1.0",
		"radix-ui": "^1.4.3",
		"rate-limiter-flexible": "^9.0.1",
		"react": "19.2.3",
		"react-day-picker": "9.13.0",
		"react-dom": "19.2.3",
		"react-hook-form": "^7.70.0",
		"react-resizable-panels": "^4.3.0",
		"recharts": "2.15.4",
		"server-only": "^0.0.1",
		"shadcn": "^3.6.3",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwindcss-animate": "^1.0.7",
		"tslog": "^4.10.2",
		"tw-animate-css": "^1.4.0",
		"use-debounce": "^10.0.6",
		"vaul": "^1.1.2",
		"zod": "^4.3.5",
		"zod-validation-error": "5.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.3.0",
		"@commitlint/cz-commitlint": "^20.3.0",
		"@commitlint/types": "^20.2.0",
		"@eslint/compat": "^2.0.0",
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^9.39.2",
		"@next/eslint-plugin-next": "^16.1.1",
		"@playwright/test": "^1.57.0",
		"@tailwindcss/postcss": "^4.1.18",
		"@tanstack/eslint-plugin-query": "^5.91.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@types/eslint-config-prettier": "^6.11.3",
		"@types/eslint-plugin-jsx-a11y": "^6.10.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.0.3",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/utils": "^8.52.0",
		"@vitejs/plugin-react": "^5.1.2",
		"@vitejs/plugin-react-swc": "^4.2.2",
		"@vitest/browser": "^4.0.16",
		"@vitest/browser-playwright": "^4.0.16",
		"@vitest/coverage-v8": "^4.0.16",
		"@vitest/eslint-plugin": "^1.6.6",
		"@vitest/ui": "^4.0.16",
		"beads-ui": "^0.9.1",
		"commitizen": "^4.3.1",
		"commitlint-config-gitmoji": "^2.3.1",
		"concurrently": "^9.2.1",
		"context@latest": "link:@vitest/browser/context@latest",
		"dotenv": "^17.2.3",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.39.2",
		"eslint-config-next": "16.1.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jest-dom": "^5.5.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-compiler": "19.1.0-rc.2",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.26",
		"eslint-plugin-tsdoc": "^0.5.0",
		"globals": "^17.0.0",
		"husky": "^9.1.7",
		"inquirer": "^13.1.0",
		"jiti": "^2.6.1",
		"jsdom": "^27.4.0",
		"lint-staged": "^16.2.7",
		"playwright": "^1.57.0",
		"postcss": "^8.5.6",
		"prettier": "^3.7.4",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"supabase": "^2.71.3",
		"supazod": "^4.5.0",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.52.0",
		"vite-tsconfig-paths": "^6.0.3",
		"vitest": "^4.0.16",
		"vitest-browser-react": "^2.0.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@swc/core",
			"esbuild",
			"msw",
			"sharp",
			"supabase",
			"unrs-resolver"
		]
	}
}
